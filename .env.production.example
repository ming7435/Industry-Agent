# Copy to .env.production on the server; never commit real secrets.
COMPOSE_PROJECT_NAME=industry-agent-prod
APP_ENV=production
MYSQL_DATABASE=industry_agent
MYSQL_USER=industry
MYSQL_PASSWORD=
MYSQL_APP_PASSWORD=
MINIO_ROOT_USER=industryminio
MINIO_ROOT_PASSWORD=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MODEL_CHAT_PROVIDER=deepseek
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_EMBEDDING_DIM=1024
# Private network/VPN address, not your computer's 127.0.0.1.
FACTORY_API_BASE_URL=
# Required by existing production telemetry exporter.
OTEL_BACKEND_ENDPOINT=
OTEL_BACKEND_AUTH=
# Keep loopback-only until an HTTPS proxy is installed.
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=8080

# Agent 镜像内已固定安装 cadgen 0.7.10，不需要 GUI 或独立 MCP 服务。
CADGEN_PYTHON=/usr/local/bin/python
CADGEN_NODE=/usr/local/bin/node
CADGEN_CACHE_DIR=/app/.runtime/text-to-cad-cache
CADGEN_DAEMON=0
CADGEN_COMPONENT_WORKERS=1
CAD_DOCUMENTS_ENABLED=false
TEXT_TO_CAD_ARTIFACT_ROOT=/app/.runtime/cad-models
TEXT_TO_CAD_DOCUMENT_ARTIFACT_ROOT=/app/output/freecad-documents
CAD_WORKER_LOCK=/app/.runtime/cad-document-worker.lock
