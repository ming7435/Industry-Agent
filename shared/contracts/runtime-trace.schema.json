{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industry-agent.local/contracts/runtime-trace.schema.json",
  "title": "Runtime Trace event",
  "type": "object",
  "additionalProperties": true,
  "required": ["event", "task_id", "trace_id"],
  "properties": {
    "timestamp": {"type": "string"},
    "event": {
      "type": "string",
      "enum": [
        "planner_start", "planner_end", "goal_parsed", "loop_start", "loop_continue", "evaluation_result", "action_selected", "capability_selected", "capability_blocked", "execution_start",
        "execution_end", "evidence_added", "review_result", "replan", "loop_stop",
        "node_started", "node_completed",
        "agent_start", "agent_end", "agent_started", "agent_completed", "agent_error", "agent_timeout",
        "tool_start", "tool_end", "tool_started", "tool_completed", "tool_error",
        "a2a_started", "a2a_completed", "a2a_error",
        "module_started", "module_completed"
      ]
    },
    "task_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 0},
    "execution_id": {"type": "string"},
    "status": {"type": "string"},
    "state_change": {"type": "object"},
    "error": {"type": "string"}
  }
}
