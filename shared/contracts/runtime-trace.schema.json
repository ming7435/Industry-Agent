{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industry-agent.local/contracts/runtime-trace.schema.json",
  "title": "Runtime Trace event",
  "type": "object",
  "additionalProperties": true,
  "required": ["event", "task_id", "trace_id"],
  "properties": {
    "timestamp": {"type": "string"},
    "event": {
      "type": "string",
      "enum": [
        "loop_start", "evaluation_result", "action_selected", "execution_start",
        "execution_end", "evidence_added", "review_result", "replan", "loop_stop",
        "node_started", "node_completed", "agent_start", "agent_end", "tool_start", "tool_end"
      ]
    },
    "task_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 0},
    "execution_id": {"type": "string"},
    "status": {"type": "string"},
    "state_change": {"type": "object"},
    "error": {"type": "string"}
  }
}
