{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industry-agent.local/contracts/runtime-loop.schema.json",
  "title": "Runtime Loop contracts",
  "definitions": {
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "reason", "confidence", "evidence_score", "missing_evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["continue", "replan", "final", "blocked"]},
        "reason": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_score": {"type": "number", "minimum": 0, "maximum": 1},
        "missing_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "loop_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["iteration", "max_iterations", "start_time", "elapsed_time", "action_history", "evidence_history", "stop_reason"],
      "properties": {
        "iteration": {"type": "integer", "minimum": 0},
        "max_iterations": {"type": "integer", "minimum": 1},
        "start_time": {"type": "number"},
        "elapsed_time": {"type": "number", "minimum": 0},
        "action_history": {"type": "array", "items": {"type": "string"}},
        "evidence_history": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "stop_reason": {"type": "string"},
        "budget_used": {"type": "number", "minimum": 0}
      }
    }
  }
}
