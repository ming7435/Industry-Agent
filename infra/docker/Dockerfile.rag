FROM python:3.11-slim

WORKDIR /app

COPY services/rag-service/requirements.txt /tmp/rag-requirements.txt
RUN pip install --no-cache-dir -r /tmp/rag-requirements.txt

COPY services/rag-service /app/services/rag-service

ENV PYTHONPATH=/app/services/rag-service:/app

CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "/app/services/rag-service", "--host", "0.0.0.0", "--port", "8020"]
