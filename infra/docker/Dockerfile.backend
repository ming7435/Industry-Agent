FROM python:3.11-slim

WORKDIR /app

COPY services/backend-service/requirements.txt /tmp/backend-requirements.txt
RUN pip install --no-cache-dir -r /tmp/backend-requirements.txt

COPY services/backend-service /app/services/backend-service

ENV PYTHONPATH=/app/services/backend-service:/app

CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "/app/services/backend-service", "--host", "0.0.0.0", "--port", "8030"]
