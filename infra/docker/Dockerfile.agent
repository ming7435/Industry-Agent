FROM python:3.11-slim

WORKDIR /app

COPY services/agent-service/requirements.txt /tmp/agent-requirements.txt
RUN pip install --no-cache-dir -r /tmp/agent-requirements.txt

COPY services/agent-service /app/services/agent-service
COPY shared /app/shared
RUN mkdir -p /app/.runtime

ENV PYTHONPATH=/app/services/agent-service:/app

CMD ["python", "-m", "uvicorn", "app.api.server:app", "--app-dir", "/app/services/agent-service", "--host", "0.0.0.0", "--port", "8010"]
