# 模拟工厂与实时监测服务
FACTORY_API_BASE_URL=http://127.0.0.1:4529
FACTORY_DEVICE_ID=TRAK-TC820LTYSI-001
MONITOR_INTERVAL_SECONDS=0.5
MONITOR_WEB_HOST=127.0.0.1
MONITOR_WEB_PORT=8001

# DeepSeek OpenAI 兼容接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 如果本机开启 Clash Verge / mihomo，Python 进程需要显式走代理，按实际端口填写。
HTTP_PROXY=
HTTPS_PROXY=
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_RETRIES=1
APP_ENV=development
ALLOW_DEGRADED_STORAGE=true
EVENT_STORE_PATH=.runtime/events.sqlite3
WORKORDER_STORE_PATH=.runtime/workorders.sqlite3
LEARNING_RESULT_STORE_PATH=.runtime/learning.sqlite3
REPORT_STORE_PATH=.runtime/reports.sqlite3

# RAG JSONL 数据目录；留空时使用内置演示数据
RAG_DATA_DIR=
RAG_SERVICE_BASE_URL=http://127.0.0.1:8020
RAG_SERVICE_TIMEOUT_SECONDS=15
RAG_ALLOW_LOCAL_FALLBACK=true
RAG_UPSERT_WHOOSH_ENABLED=true
RAG_UPSERT_MILVUS_ENABLED=true

# 可选的远程 MCP 服务地址；为空时使用本地兼容处理器
MCP_PLC_URL=
MCP_MES_URL=
MCP_CAD_URL=
CAD_SERVICE_BASE_URL=
CAD_ALLOW_DEMO_FALLBACK=true
CAD_MYSQL_HOST=
CAD_MYSQL_PORT=3306
CAD_MYSQL_DATABASE=industry_maintenance
MCP_RAG_URL=

# 质检闭环和维修经验的 MySQL 持久化；MYSQL_HOST 为空时使用本地内存回退
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=industrial_maintenance
