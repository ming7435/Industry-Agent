# 项目唯一运行配置模板
# 复制为仓库根目录 .env 后填写密钥。所有本地服务共享这一份文件。

# DeepSeek 官方 OpenAI 兼容接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MODEL_PROVIDER=remote
# 聊天模型固定使用 DeepSeek 官方接口；不要改为 SiliconFlow。
MODEL_CHAT_PROVIDER=deepseek
MODEL_SERVICE_BASE_URL=http://127.0.0.1:8040

# 专家技能试运行沙箱（OpenSandbox）；默认关闭，失败关闭不回退
SKILL_SANDBOX_ENABLED=false
SKILL_SANDBOX_DOMAIN=127.0.0.1:18080
# agent-service 在 Compose 容器中访问宿主 OpenSandbox Server 的地址。
SKILL_SANDBOX_CONTAINER_DOMAIN=host.docker.internal:18080
SKILL_SANDBOX_PROTOCOL=http
SKILL_SANDBOX_API_KEY=
SKILL_SANDBOX_IMAGE=industry-skill-runner:0.1
# 沙箱内访问宿主 Model Service；Docker Desktop 使用 host.docker.internal
SKILL_SANDBOX_MODEL_BASE_URL=http://host.docker.internal:8040
SKILL_SANDBOX_ALLOWED_HOSTS=host.docker.internal
SKILL_SANDBOX_TIMEOUT_SECONDS=180
# 首次创建沙箱可能需要拉取镜像，就绪等待默认 300 秒
SKILL_SANDBOX_READY_TIMEOUT_SECONDS=300
SKILL_SANDBOX_CPU=1
SKILL_SANDBOX_MEMORY=1Gi
# 仅开发排障时设为 true；生产保持 false，避免隔离失效
SKILL_SANDBOX_FALLBACK=false
# 通过 OpenSandbox Server 代理访问临时容器；宿主和 Compose 都适用。
SKILL_SANDBOX_USE_SERVER_PROXY=true
# 如容器无法通过 host.docker.internal 访问 Model Service，再改为 0.0.0.0
MODEL_SERVICE_BIND_HOST=127.0.0.1

# 本地服务地址
FACTORY_API_BASE_URL=http://127.0.0.1:4529
# 仅显式 virtual 模式允许故障整线停机及人工确认后的复机；其他值只监控
FACTORY_CONTROL_MODE=virtual
# 模拟质检需显式开启；仅开发环境，所有输出不能用于真实生产放行
QUALITY_SIMULATION_ENABLED=false
MONITOR_INTERVAL_SECONDS=0.5
MONITOR_WEB_HOST=127.0.0.1
MONITOR_WEB_PORT=8001
AGENT_SERVICE_BASE_URL=http://127.0.0.1:8010
RAG_SERVICE_BASE_URL=http://127.0.0.1:8020
RAG_SERVICE_TIMEOUT_SECONDS=30
RAG_ALLOW_LOCAL_FALLBACK=false
BACKEND_SERVICE_BASE_URL=http://127.0.0.1:8030
CAD_SERVICE_BASE_URL=http://127.0.0.1:8050
MCP_CAD_URL=http://127.0.0.1:8050

# Agent 写接口令牌；本地开发留空，生产环境必须设置强随机值
AGENT_API_TOKEN=
# Agent/Monitor 与 Backend 共享的独立内部令牌；MySQL 模式必须配置，不能发送给浏览器
BACKEND_INTERNAL_TOKEN=
RAG_INTERNAL_TOKEN=
# RAG HTTP JSONL 入库允许读取的根目录
RAG_ALLOWED_INGEST_ROOT=data
RAG_INGEST_MAX_BYTES=26214400
MCP_MES_URL=http://127.0.0.1:8030
MCP_QMS_URL=http://127.0.0.1:8030
MCP_INVENTORY_URL=http://127.0.0.1:8030

# 运行时存储
APP_ENV=development
ALLOW_DEGRADED_STORAGE=false
BACKEND_STORAGE=mysql
WORKORDER_BACKEND=mysql
REDIS_URL=redis://127.0.0.1:6379/0
SHORT_MEMORY_TTL_SECONDS=3600
# 旧 *_STORE_PATH 和 BACKEND_SQLITE_PATH 仅用于旧数据迁移/隔离测试，在线不启用 SQLite。

# RAG 检索与生成
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8020
RAG_DATA_DIR=data
WHOOSH_INDEX_DIR=data/index/whoosh
INGESTION_CACHE_ENABLED=true
INGESTION_CACHE_DIR=data/.ingestion_cache
DEFAULT_CORPUS=manuals
BM25_TOP_K=20
DENSE_TOP_K=20
RRF_K=60
FUSION_TOP_M=30
RERANK_TOP_N=5
BM25_TIMEOUT_MS=3000
DENSE_TIMEOUT_MS=5000
RERANK_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=35000
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
RAG_UPSERT_WHOOSH_ENABLED=true
RAG_UPSERT_MILVUS_ENABLED=true

# RAG 向量/重排服务；没有配置时仍可使用 BM25 检索
# 仅供 RAG 向量化、重排和可选视觉能力使用，不参与 DeepSeek 聊天。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 可选的离线存储
MILVUS_URI=http://127.0.0.1:19530
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DATABASE=industry_agent
MILVUS_COLLECTIONS=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=industry_agent
MYSQL_CHARSET=utf8mb4
OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=rag-documents
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_PREFIX=source

# 可选视觉/OCR配置
SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_VISION_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
DASHSCOPE_API_KEY=
QWEN_API_KEY=
LOCAL_OCR_BACKEND=rapidocr
LOCAL_OCR_RUNTIME_DIR=.runtime/ocr
ODA_FILE_CONVERTER=

# text-to-cad 原生内核（cadgen 0.7.10）；留空使用启动服务的 Python。
CADGEN_PYTHON=
# STL/工程图导出需要 Node.js >=20；留空从 PATH 查找 node。
CADGEN_NODE=
CADGEN_CACHE_DIR=.runtime/text-to-cad-cache
CADGEN_DAEMON=0
CADGEN_COMPONENT_WORKERS=1
# 保持现有存储路径，避免迁移后历史运行、发布文件或任务不可见。
TEXT_TO_CAD_ARTIFACT_ROOT=.runtime/cad-models
TEXT_TO_CAD_DOCUMENT_ARTIFACT_ROOT=output/freecad-documents
CAD_DOCUMENTS_ENABLED=false
CAD_WORKER_LOCK=.runtime/cad-document-worker.lock

# 质检视觉算法（可选）；安装 services/agent-service/requirements-vision.txt。
# 使用服务端可信的本地权重文件，请求期间不会自动联网下载模型。
QUALITY_PATCHCORE_BACKBONE_WEIGHTS=
QUALITY_YOLO_WEIGHTS=
# Optional trusted deployment metadata (name, scope, source, classes, SHA256).
QUALITY_YOLO_METADATA=
# Optional shared read-only synthetic PatchCore preset: model.json + memory.npz.
QUALITY_PATCHCORE_PRESET_DIR=
# Optional shared gear normal memory bank: model.json + memory.npz.
QUALITY_PATCHCORE_GEAR_PRESET_DIR=
# 正常特征库、视觉检测记录按登录账号隔离保存在此目录。
QUALITY_VISION_ROOT=.runtime/quality-vision
# 配置后 Agent Service 自动监听 incoming 子目录，使用现有齿轮正常记忆库自动检测。
QUALITY_VISION_AUTO_INBOX_DIR=
