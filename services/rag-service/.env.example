# Copy to .env and fill in the real values. Never commit the resulting .env.
# pydantic-settings reads this file from the service root (and from the CWD).

# --- LLM (required for generated answers) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- retrieval fan-out ---
BM25_TOP_K=20
DENSE_TOP_K=20
RRF_K=60
FUSION_TOP_M=30
RERANK_TOP_N=5

# --- per-stage budgets (ms) ---
BM25_TIMEOUT_MS=3000
DENSE_TIMEOUT_MS=5000
RERANK_TIMEOUT_MS=15000
# Must stay larger than LLM_TIMEOUT_MS, otherwise generation is cut off by the
# overall budget and every answer comes back empty with reason=request_timeout.
REQUEST_TIMEOUT_MS=35000

# --- models ---
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MIN_CHARACTERS=20
EMBEDDING_NORMALIZE=true
RERANKER_BATCH_SIZE=16
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- offline corpus ---
RAG_DATA_DIR=data
INGESTION_CACHE_ENABLED=true
INGESTION_CACHE_DIR=data/.ingestion_cache
DEFAULT_CORPUS=manuals

# --- offline stores ---
WHOOSH_INDEX_DIR=data/index/whoosh
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=industry_agent
MILVUS_COLLECTIONS=
RAG_EXPERIENCE_COLLECTION=maint_fault_events
MILVUS_HOST=localhost
MILVUS_PORT=19530
# Collections are derived from the first-level directories under RAG_DATA_DIR.
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_BATCH_SIZE=128
MILVUS_DROP_EXISTING=false
RAG_UPSERT_WHOOSH_ENABLED=true
RAG_UPSERT_MILVUS_ENABLED=true

# --- MySQL metadata store (offline ingestion bookkeeping) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=industry_agent
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10

# --- optional MinIO/S3-compatible storage for original source files ---
OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=rag-documents
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_PREFIX=source
OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/rag-documents

# --- optional: SiliconFlow vision image / scanned-page recognition during parsing ---
# Reuses SILICONFLOW_API_KEY above.
SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_VISION_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions

# --- service ---
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8020
LOG_LEVEL=INFO
HEALTH_PROBE_TIMEOUT_MS=3000
