# Copy to .env and fill in the real values. Never commit the resulting .env.
# pydantic-settings reads this file from the service root (and from the CWD).

# --- LLM (required for generated answers) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- retrieval fan-out ---
BM25_TOP_K=20
DENSE_TOP_K=20
RRF_K=60
FUSION_TOP_M=30
RERANK_TOP_N=5

# --- per-stage budgets (ms) ---
BM25_TIMEOUT_MS=150
DENSE_TIMEOUT_MS=200
RERANK_TIMEOUT_MS=300
# Must stay larger than LLM_TIMEOUT_MS, otherwise generation is cut off by the
# overall budget and every answer comes back empty with reason=request_timeout.
REQUEST_TIMEOUT_MS=35000
HEALTH_PROBE_TIMEOUT_MS=500

# --- models ---
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MIN_CHARACTERS=20
EMBEDDING_NORMALIZE=true
RERANKER_BATCH_SIZE=16
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- offline corpus ---
RAG_DATA_DIR=data/SHUJU
DEFAULT_CORPUS=manuals

# --- offline stores ---
WHOOSH_INDEX_DIR=data/index/whoosh
MILVUS_URI=http://localhost:19530
MILVUS_HOST=localhost
MILVUS_PORT=19530
# Primary fallback collection. Online retrieval also reads MILVUS_COLLECTIONS when set.
MILVUS_COLLECTION=industry_rag_alarm_codes
# Standard typed collections written by the offline pipeline.
MILVUS_COLLECTIONS=industry_rag_alarm_codes,industry_rag_alarm_solutions,industry_rag_bom,industry_rag_manuals,industry_rag_sop,industry_rag_drawings,industry_rag_maintenance,industry_rag_safety_rules,industry_rag_troubleshooting
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_BATCH_SIZE=128
MILVUS_DROP_EXISTING=false

# --- MySQL metadata store (offline ingestion bookkeeping) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=agent
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10

# --- MinIO/S3-compatible storage for original DXF source files ---
OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=cad-drawings
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_PREFIX=dxf-source
OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/cad-drawings

# --- optional: Qwen-VL image / scanned-page recognition during parsing ---
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_VL_MODEL=qwen-vl-max
QWEN_VL_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# --- optional: DWG -> DXF conversion (AutoCAD/ODA) ---
ODA_FILE_CONVERTER=

# --- service ---
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO
HEALTH_PROBE_TIMEOUT_MS=3000
